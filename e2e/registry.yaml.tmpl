apiVersion: v1
kind: Namespace
metadata:
  name: ${REGISTRY_NS}
  labels:
    pod-security.kubernetes.io/enforce: privileged
    pod-security.kubernetes.io/audit: privileged
    pod-security.kubernetes.io/warn: privileged
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${REGISTRY_NAME}
  namespace: ${REGISTRY_NS}
  labels:
    app: cex-dra-registry
spec:
  replicas: 1
  selector:
    matchLabels:
      app: cex-dra-registry
  template:
    metadata:
      labels:
        app: cex-dra-registry
    spec:
      containers:
        - name: registry
          image: ${REGISTRY_IMAGE}
          imagePullPolicy: IfNotPresent
          ports:
            - name: registry
              containerPort: 5000
          env:
            - name: REGISTRY_HTTP_ADDR
              value: :5000
            - name: REGISTRY_STORAGE_DELETE_ENABLED
              value: "true"
          readinessProbe:
            httpGet:
              path: /v2/
              port: 5000
            initialDelaySeconds: 2
            periodSeconds: 3
          volumeMounts:
            - name: data
              mountPath: /var/lib/registry
      volumes:
        - name: data
          emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: ${REGISTRY_NAME}
  namespace: ${REGISTRY_NS}
spec:
  type: NodePort
  selector:
    app: cex-dra-registry
  ports:
    - name: registry
      port: 5000
      targetPort: 5000
      nodePort: ${REGISTRY_NODEPORT}
